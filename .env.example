[TEMPLATE]
# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# MariaDB Localhost (Banco de Dados Principal — única persistência remota)
DB_HOST="localhost"
DB_PORT=3306
DB_USER="root"
DB_PASSWORD=""
DB_NAME="pdv_murupi"
SERVER_PORT=3001
VITE_API_URL="http://localhost:3001"

# Chave PIX pública usada para gerar o payload Copia e Cola (fallback; o
# valor operacional agora vem de RestaurantSettings.pix)
VITE_PIX_KEY=
